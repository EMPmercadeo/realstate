---
import Base from '@/layouts/Base.astro';
import Recorrido from '@/components/Recorrido.astro';
---
<Base title="Recorrido en fotos · Residencia Altos de San Cristóbal" full sinHeader>
  <Recorrido />
  <main class="tras-recorrido"><section class="seccion"><div class="container"><p class="muted">Versión en fotos del recorrido. <a href="/">Volver al sobrevuelo 3D</a>.</p></div></section></main>
</Base>
<style is:global>.tras-recorrido { position: relative; z-index: 2; background: var(--bg); }</style>
