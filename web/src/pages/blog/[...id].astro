---
import Base from '@/layouts/Base.astro';
import { render } from 'astro:content';
import { articulos, fechaLarga } from '@/data/blog';

export async function getStaticPaths() {
  const posts = await articulos();
  return posts.map((p) => ({ params: { id: p.id }, props: { post: p } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
---
<Base title={`${post.data.titulo} · Residencia Altos de San Cristóbal`} description={post.data.resumen} lang={post.data.idioma} noindex={post.data.borrador}>
  <article class="seccion">
    <div class="container prosa">
      <p class="small muted"><a href="/blog">Blog</a> · {post.data.pais} · <time datetime={post.data.fecha.toISOString().slice(0, 10)}>{fechaLarga(post.data.fecha)}</time></p>
      <h1>{post.data.titulo}</h1>
      <p class="lead">{post.data.resumen}</p>
      <Content />
      <p style="margin-top:2.5rem"><a class="btn" href="/contacto">Solicitar información de la residencia</a></p>
    </div>
  </article>
</Base>
