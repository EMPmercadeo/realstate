---
import Base from '@/layouts/Base.astro';
import Cine from '@/components/Cine.astro';
const comparar = [
  ['hospitalizacion', 'Personas encamadas · 10 camas'],
  ['comedor', 'Comedor y TV'],
  ['salon-2', 'Salón amarillo · movilidad reducida'],
  ['refrigerios', 'Área de coffee break'],
  ['terraza', 'Terraza al aire libre'],
  ['cocina', 'Cocineta del edificio gris'],
  ['bano-accesible', 'Baño accesible para usuarios'],
];
---
<Base title="Residencia de retiro en David, Chiriquí · Altos de San Cristóbal" full sinHeader>
  <Cine />

  <main class="tras-recorrido">
    <section class="seccion" id="proyecto">
      <div class="container cols ancha">
        <div>
          <h2>Qué incluye</h2>
          <p class="lead">Un campus completo, cercado y con portones eléctricos, adaptado para el cuidado de adultos mayores: personas encamadas, cuartos privados, terapia, comedor, huerto y áreas al aire libre.</p>
          <ul class="lista-plana">
            <li><span>Edificio gris (2 niveles)</span><span>22 camas: personas encamadas, movilidad reducida y personas que deambulan</span></li>
            <li><span>Casa amarilla</span><span>recepción 24 h, consultorio, terapia, talleres, comedor y TV, 4 cuartos privados</span></li>
            <li><span>Terraza y área de coffee break</span><span>edificio gris, piso alto</span></li>
            <li><span>Gazebo de juegos y tina de hidroterapia</span><span>jardín interno</span></li>
            <li><span>Huerto cercado y estacionamiento accesible</span><span>exteriores</span></li>
            <li><span>Seguridad certificada</span><span>alarma contra incendios, extintores, rutas de evacuación</span></li>
          </ul>
        </div>
        <dl class="datos">
          <div><dt>Terreno</dt><dd>2.500<small>m²</small></dd></div>
          <div><dt>Capacidad</dt><dd>26<small>camas</small></dd></div>
          <div><dt>Edificios</dt><dd>2<small>de dos niveles</small></dd></div>
          <div><dt>Avance</dt><dd>75 %<small>del proyecto</small></dd></div>
        </dl>
      </div>
    </section>

    <section class="seccion" id="avance-3d">
      <div class="container">
        <h2>Avance del modelo 3D</h2>
        <p class="lead">Los dos edificios ya tienen sus interiores amueblados en el modelo: personas encamadas con estación de enfermería, salón amarillo, área de coffee break, cuartos privados, comedor, terapia y más.</p>
        <div class="espacios">
          <a class="espacio" href="/avances#edificio-gris"><img src="/avances/int_gris_hosp.jpg" alt="Personas encamadas en el modelo 3D" loading="lazy" /><div><h3>Personas encamadas</h3><p>10 camas y estación de enfermería</p></div></a>
          <a class="espacio" href="/avances#edificio-gris"><img src="/avances/int_gris_salon2.jpg" alt="Salón amarillo en el modelo 3D" loading="lazy" /><div><h3>Salón amarillo</h3><p>Personas con movilidad reducida</p></div></a>
          <a class="espacio" href="/avances#casa-amarilla"><img src="/avances/int_casa_comedor.jpg" alt="Comedor de la casa amarilla en el modelo 3D" loading="lazy" /><div><h3>Casa amarilla</h3><p>Comedor, terapia y cuartos privados</p></div></a>
        </div>
        <p style="margin-top:1.4rem"><a class="btn" href="/avances">Ver todo el avance</a></p>
      </div>
    </section>

    <section class="seccion gris" id="antes-despues">
      <div class="container">
        <h2>Hoy y así quedará</h2>
        <p class="lead">Fotos reales de los espacios tal como están, y la propuesta de adecuación sobre la misma foto. Arrastra la línea para comparar.</p>
        <div class="antes-despues">
          {comparar.map(([f, t]) => (
            <div class="ad">
              <img src={`/fotos-despues/${f}.jpg`} alt={`${t}, así quedará`} loading="lazy" />
              <div class="ad-antes"><img src={`/fotos-antes/${f}.jpg`} alt={`${t}, hoy`} loading="lazy" /></div>
              <span class="ad-linea"></span>
              <input type="range" min="0" max="100" value="50" aria-label={`Comparar ${t}`} />
              <span class="ad-l">Hoy</span><span class="ad-r">Así quedará</span>
              <span class="ad-t">{t}</span>
            </div>
          ))}
        </div>
      </div>
    </section>
    <script>
      document.querySelectorAll('.ad').forEach((el) => {
        const r = el.querySelector('input'); const a = el.querySelector('.ad-antes'); const l = el.querySelector('.ad-linea');
        r?.addEventListener('input', () => { a.style.clipPath = `inset(0 ${100 - r.value}% 0 0)`; l.style.left = `${r.value}%`; });
      });
    </script>

    <section class="seccion" id="espacios">
      <div class="container">
        <h2>Los espacios</h2>
        <p class="lead">Así quedarán las áreas principales. Cada imagen vuelve a esa parada del recorrido.</p>
        <div class="espacios">
          <a class="espacio" href="#parada=gris"><img src="/fotos-despues/hospitalizacion.jpg" alt="Sala de personas encamadas con camas de hospital" loading="lazy" /><div><h3>Personas encamadas</h3><p>10 camas con estación de enfermería</p></div></a>
          <a class="espacio" href="#parada=casa"><img src="/fotos-despues/comedor.jpg" alt="Comedor de la casa amarilla" loading="lazy" /><div><h3>Comedor y TV</h3><p>Casa amarilla</p></div></a>
          <a class="espacio" href="#parada=terraza"><img src="/fotos-despues/refrigerios.jpg" alt="Área de coffee break del piso alto" loading="lazy" /><div><h3>Área de coffee break</h3><p>Edificio gris, piso alto</p></div></a>
          <a class="espacio" href="#parada=terraza"><img src="/fotos-despues/terraza.jpg" alt="Terraza del piso alto" loading="lazy" /><div><h3>Terraza al aire libre</h3><p>Para las personas que deambulan o caminan</p></div></a>
          <a class="espacio" href="#parada=entrada"><img src="/fotos-reales/fachada-reloj.jpg" alt="Fachada de la casa amarilla" loading="lazy" /><div><h3>Entrada</h3><p>Portón eléctrico y cerca perimetral</p></div></a>
          <a class="espacio" href="#parada=gris"><img src="/fotos-reales/edificio-gris.jpg" alt="Edificio gris" loading="lazy" /><div><h3>Edificio gris</h3><p>Dos niveles, 22 camas</p></div></a>
        </div>
      </div>
    </section>

    <section class="seccion" id="inversionistas">
      <div class="container cols">
        <div>
          <h2>Para inversionistas</h2>
          <p class="lead">La propiedad se entrega adecuada y equipada según el programa de espacios. Solicita el expediente con planos, programa de espacios y proyección de operación.</p>
        </div>
        <div>
          <p class="muted">Formulario y datos de contacto pendientes de definir con la propietaria.</p>
          <p class="small muted">¿Prefieres la maqueta técnica? <a href="/recorrido">Abrir la maqueta 3D navegable</a>.</p>
        </div>
      </div>
    </section>
    <footer>
      <div class="container">Residencia Altos de San Cristóbal · David, Chiriquí, Panamá. Proyecto en comercialización.</div>
    </footer>
  </main>
</Base>

<style is:global>
  .tras-recorrido { position: relative; z-index: 2; background: var(--bg); }
  .tras-recorrido .seccion:first-child { padding-top: 5rem; }
</style>
