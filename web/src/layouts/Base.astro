---
import '@fontsource-variable/outfit/wght.css';
import fuente from '@fontsource-variable/outfit/files/outfit-latin-wght-normal.woff2?url';
import '@/styles/global.css';
import '@/styles/visor.css';
import MenuSitio from '@/components/MenuSitio.astro';
import Pie from '@/components/Pie.astro';
import { MENU, enlaceContacto } from '@/data/sitio';
interface Props { title: string; description?: string; lang?: string; full?: boolean; sinHeader?: boolean; noindex?: boolean; imagen?: string; sinSaltar?: boolean; }
const {
  title,
  description = 'Residencia de retiro y cuidado para adultos mayores en Altos de San Cristóbal, David, Chiriquí: dos edificios, 26 camas y jardín, lista para operar. Recorrido 3D, vistas 360° y planos.',
  lang = 'es',
  full = false,
  sinHeader = false,
  noindex = false,
  sinSaltar = false,
  imagen = '/avances/int_gris_hosp.jpg',
} = Astro.props;
const actual = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonica = new URL(Astro.url.pathname, Astro.site);
const og = new URL(imagen, Astro.site);
// datos estructurados: la propiedad como anuncio inmobiliario
const datos = {
  '@context': 'https://schema.org',
  '@type': 'RealEstateListing',
  name: 'Residencia Altos de San Cristóbal',
  description,
  url: new URL('/', Astro.site).href,
  image: og.href,
  inLanguage: 'es',
  about: {
    '@type': 'Place',
    name: 'Residencia Altos de San Cristóbal',
    address: { '@type': 'PostalAddress', streetAddress: 'Altos de San Cristóbal', addressLocality: 'David', addressRegion: 'Chiriquí', addressCountry: 'PA' },
  },
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonica} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#17352a" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_PA" />
    <meta property="og:site_name" content="Residencia Altos de San Cristóbal" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={og} />
    <meta property="og:image:alt" content="Residencia Altos de San Cristóbal: interior del proyecto ya adecuado" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="twitter:card" content="summary_large_image" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="preload" href={fuente} as="font" type="font/woff2" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify(datos)} />
  </head>
  <body>
    {!sinSaltar && <a class="saltar" href="#contenido">Saltar al contenido</a>}
    {!sinHeader && (
      <header class="cabecera">
        <nav class="nav container" aria-label="Principal">
          <a class="brand" href="/"><i aria-hidden="true"></i>Residencia Altos de San Cristóbal</a>
          <ul class="nav-links">
            {MENU.map((m) => <li><a href={m.href} aria-current={actual === m.href ? 'page' : undefined}>{m.t}</a></li>)}
            <li><a class="btn" href={enlaceContacto()}>Solicitar información</a></li>
          </ul>
          <div class="nav-movil"><MenuSitio /></div>
        </nav>
      </header>
    )}
    {full ? <slot /> : <main id="contenido"><slot /></main>}
    {!full && <Pie />}
  </body>
</html>
