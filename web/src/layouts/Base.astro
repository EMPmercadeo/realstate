---
import '@/styles/global.css';
interface Props { title: string; description?: string; lang?: string; full?: boolean; }
const {
  title,
  description = 'Residencia de retiro y cuidado para adultos mayores en Altos de San Cristóbal, David, Chiriquí. Recorrido 3D del proyecto.',
  lang = 'es',
  full = false,
} = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="container">
      <nav class="nav">
        <a class="brand" href="/">Residencia Altos de San Cristóbal</a>
        <ul>
          <li><a href="/#proyecto">El proyecto</a></li>
          <li><a href="/#espacios">Espacios</a></li>
          <li><a href="/blog">Blog</a></li>
          <li><a class="btn" href="/recorrido">Recorrido 3D</a></li>
        </ul>
      </nav>
    </header>
    {full ? <slot /> : <main><slot /></main>}
    {!full && (
      <footer>
        <div class="container">Residencia Altos de San Cristóbal · David, Chiriquí, Panamá. Proyecto en comercialización.</div>
      </footer>
    )}
  </body>
</html>
